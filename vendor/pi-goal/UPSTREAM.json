  "copiedFilesArePrePatchHashes": true,
  "bridgePatch": {
    "purpose": "Expose the upstream runtime to the bridge while isolating it from a user's independently installed pi-goal extension.",
    "changes": [
      "registerGoalRuntime and the default goal factory return runtime, commands, and runController.",
      "Legacy global pi-goal-state.json cleanup is disabled; native bridge session entries remain authoritative.",
      "Commands, tools, native session entry types, contract and continuation markers, and run event channels use the bridge namespace; workflow:mutex:v1 remains shared for concurrency protection.",
      "Managed state events carry persisted full Goal snapshots and forward same-status usage/waiting changes; terminal usage survives upstream active state clearing."
    ],
    "namespace": {
      "command": "bridge-upstream-goal",
      "controlCommand": "bridge-goal",
      "tools": [
        "bridge_goal_complete",
        "bridge_goal_blocked",
        "bridge_goal_wait"
      ],
      "sessionEntry": "bridge-goal-state",
      "runChannels": "bridge-pi-goal:*",
      "contract": "bridge-goal-contract",
      "markers": "bridge-pi-goal-*"
    }
  },
